{
  "sandbox": {
    "filesystem": {
      "allowWrite": ["/tmp/kw", "/private/tmp/kw"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/hooks/agent-spawn-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/hooks/read-result-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/hooks/bash-read-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
