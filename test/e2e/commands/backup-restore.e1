# SPDX-License-Identifier: Apache-2.0
#
# The commands of the backup and restore guide. test/e2e/backup-restore.sh runs them by name through hack/docs-e1.sh.
# One block per '# e1=<name>' line; the lines up to the next marker are the block's commands.
# Limits (hack/docs-e1.sh header): empty lines are dropped, so keep heredoc bodies free of them; a line that
# is exactly a marker starts a block also inside a heredoc body, so never write one there.
# Variables (each block sets its own, so a block runs alone): NS is the namespace and REL the Helm release of the
# install the block acts on (default koinon, koinon). A restore into a fresh namespace sets both to the target's.
# The chart names its objects <release>-api, <release>-pg, <release>-kek and so on when the release name contains
# "koinon" and there is no fullnameOverride and no secrets.kek.existingSecret (helm install prints the real names).
# Variables of the two pipe blocks (pipe-db, pipe-keys): SRC_NS and SRC_REL (and SRC_GWKEY) are the live source install, NS and REL
# the target (both are required: a source that is the target would be wiped before it is read). Their commands stream the source into the target, so they
# need both installs at once: test/drill runs them, in the order stop, hold, pipe-db, pipe-keys, start, compare-keys,
# verify-keys, release (backup-restore.sh restores in place from files and cannot). With a gateway recipient key, run
# verify-gateway-key after start too.
# Not here and not checked by any test: a CloudNativePG backup restore. The chart configures no CNPG backup yet
# (ADR 0076 decision 9), so there is nothing to restore from. Tracked in https://github.com/stateracloud/koinon/issues/910.
# The gateway recipient key (docs/dev/gateway-recipient-key.md): with gateway.mcp.driver=koinon the stored MCP
# credentials are sealed to it, and only its Secret (GWKEY, default <release>-gateway-recipient-key) holds the private
# half. Its blocks do nothing on an install without that Secret. The Secret is guarded: only the key-admin service
# account may write it, so restore-gateway-key writes it as that account (kubectl --as; the person needs the right to
# impersonate it; GWADMIN overrides its name, default <release>-gateway-key-admin). A KMS-wrapped key opens only with the same wrapping key: the target uses the source's KMS key.
# Fetch at a tag: https://raw.githubusercontent.com/stateracloud/koinon/<tag>/test/e2e/commands/backup-restore.e1
# e1=backup-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
kubectl -n "$NS" exec deploy/"$REL"-api -- koinon-api keys export > koinon-kek-backup.yaml
# e1=note-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
# Only IDs and fingerprints: no key material. Keep the file with the backup; compare-keys reads it after the restore.
kubectl -n "$NS" exec deploy/"$REL"-api -- koinon-api keys status > koinon-keys-status.txt
# e1=check-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
fp=$(kubectl -n "$NS" exec deploy/"$REL"-api -- koinon-api keys status | awk '$2 == "active" { print $NF }')
test -n "$fp"
grep -q "fingerprint $fp" koinon-kek-backup.yaml || { echo "the backup does not hold the active key $fp" >&2; false; }
# e1=backup-gateway-key
NS=${NS:-koinon}
REL=${REL:-koinon}
GWKEY=${GWKEY:-$REL-gateway-recipient-key}
# Run it before backup-db, as backup-keys. The file holds the wrapped private keys (on the local backend the keys
# as they are): keep it with the KEK backup, never in a log. Without the Secret there is no file.
rm -f koinon-gateway-key-backup.yaml
if kubectl -n "$NS" get secret/"$GWKEY" > /dev/null 2>&1; then
  (umask 077 && kubectl -n "$NS" get secret/"$GWKEY" -o go-template='apiVersion: v1{{"\n"}}kind: Secret{{"\n"}}metadata:{{"\n"}}  name: '"$GWKEY"'{{"\n"}}  labels:{{"\n"}}{{range $k, $v := .metadata.labels}}    {{$k}}: {{printf "%q" $v}}{{"\n"}}{{end}}type: Opaque{{"\n"}}data:{{"\n"}}{{range $k, $v := .data}}  {{$k}}: {{$v}}{{"\n"}}{{end}}' > koinon-gateway-key-backup.yaml)
else
  echo "no gateway recipient key Secret $GWKEY: nothing to back up"
fi
# e1=backup-db
NS=${NS:-koinon}
REL=${REL:-koinon}
PRIMARY=$(kubectl -n "$NS" get pod -l cnpg.io/cluster=$REL-pg,cnpg.io/instanceRole=primary -o name)
kubectl -n "$NS" exec "$PRIMARY" -c postgres -- pg_dump --format=custom --dbname=koinon > koinon.dump
# e1=verify-dump
NS=${NS:-koinon}
REL=${REL:-koinon}
PRIMARY=$(kubectl -n "$NS" get pod -l cnpg.io/cluster=$REL-pg,cnpg.io/instanceRole=primary -o name)
kubectl -n "$NS" exec -i "$PRIMARY" -c postgres -- pg_restore --list < koinon.dump > /dev/null
# e1=check-gateway-key
NS=${NS:-koinon}
REL=${REL:-koinon}
# Run it after backup-db. Every gateway key that a stored credential can name (all but retired) is in the backup.
# Rows are never deleted, so a key that the database has and the file does not is a key added after the backup.
PRIMARY=$(kubectl -n "$NS" get pod -l cnpg.io/cluster=$REL-pg,cnpg.io/instanceRole=primary -o name)
ids=$(kubectl -n "$NS" exec "$PRIMARY" -c postgres -- psql --dbname=koinon -Atq -c "SELECT key_id FROM gateway_recipient_keys WHERE state <> 'retired'")
for id in $ids; do
  grep -q "^  $id: " koinon-gateway-key-backup.yaml 2> /dev/null || { echo "the gateway key backup does not hold the key $id: run backup-gateway-key and backup-db again" >&2; false; }
done
# e1=stop
NS=${NS:-koinon}
REL=${REL:-koinon}
# A new install's key-admin Jobs (the KEK's and the gateway key's) finish first: a Job that writes a key during the
# restore would add a key that no restored row names.
if test -n "$(kubectl -n "$NS" get job -l app.kubernetes.io/instance=$REL,app.kubernetes.io/component=key-admin -o name)"; then
  kubectl -n "$NS" wait --for=condition=complete job -l app.kubernetes.io/instance=$REL,app.kubernetes.io/component=key-admin --timeout=15m
fi
# Note the replica count of each Deployment in koinon-replicas.txt: start brings each one back to it. A count of 0 is
# from an earlier run of stop: then the note of that run stays. With no note and a count of 0, stop fails.
for d in api reconciler agentd mcp-gateway; do
  kubectl -n "$NS" get deployment/"$REL-$d" > /dev/null 2>&1 || continue
  n=$(kubectl -n "$NS" get deployment/"$REL-$d" -o jsonpath='{.spec.replicas}')
  if test "$n" = 0 && test -f koinon-replicas.txt; then n=$(awk -v d="$d" '$1 == d {print $2}' koinon-replicas.txt); fi
  case "$n" in
    '' | 0 | *[!0-9]*) echo "deployment/$REL-$d runs 0 copies and no note has its count: add \"$d <count>\" to koinon-replicas.txt" >&2; false ;;
  esac
  echo "$d $n"
done > koinon-replicas.txt.new
mv koinon-replicas.txt.new koinon-replicas.txt
kubectl -n "$NS" scale deployment/"$REL"-agentd --replicas=0
kubectl -n "$NS" wait --for=delete pod -l app.kubernetes.io/instance=$REL,app.kubernetes.io/component=agentd --timeout=10m
kubectl -n "$NS" scale deployment/"$REL"-reconciler deployment/"$REL"-api --replicas=0
kubectl -n "$NS" wait --for=delete pod -l "app.kubernetes.io/instance=$REL,app.kubernetes.io/component in (api,reconciler)" --timeout=5m
# koinon-mcp-gateway has a database login and loads the gateway keys: it stops too (an install without it skips this).
if kubectl -n "$NS" get deployment/"$REL"-mcp-gateway > /dev/null 2>&1; then
  kubectl -n "$NS" scale deployment/"$REL"-mcp-gateway --replicas=0
  kubectl -n "$NS" wait --for=delete pod -l app.kubernetes.io/instance=$REL,app.kubernetes.io/component=mcp-gateway --timeout=5m
fi
# e1=hold
NS=${NS:-koinon}
REL=${REL:-koinon}
kubectl -n "$NS" set env deployment/"$REL"-api deployment/"$REL"-reconciler deployment/"$REL"-agentd KOINON_RESTORE_HOLD=true
# e1=restore-db
NS=${NS:-koinon}
REL=${REL:-koinon}
PRIMARY=$(kubectl -n "$NS" get pod -l cnpg.io/cluster=$REL-pg,cnpg.io/instanceRole=primary -o name)
kubectl -n "$NS" exec "$PRIMARY" -c postgres -- psql --dbname=koinon -v ON_ERROR_STOP=1 \
  -c 'DROP SCHEMA IF EXISTS dbos CASCADE' -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public AUTHORIZATION pg_database_owner' -c 'GRANT USAGE ON SCHEMA public TO PUBLIC'
kubectl -n "$NS" exec -i "$PRIMARY" -c postgres -- pg_restore --dbname=koinon --exit-on-error < koinon.dump
# e1=restore-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
# The KEK Secret is guarded: kubectl cannot replace one that exists (admission refuses it), so a Secret that
# is there (the usual case: a new install made its own first KEK) is merged with the backup by koinon-api itself,
# which needs one pod: keys import adds the backup's KEKs, makes its active KEK active and removes none. It
# refuses a KEK that keys retire removed (--allow-retired overrides, inactive). A Secret that is gone is created with apply.
if kubectl -n "$NS" get secret/"$REL"-kek > /dev/null 2>&1; then
  kubectl -n "$NS" scale deployment/"$REL"-api --replicas=1
  kubectl -n "$NS" rollout status deployment/"$REL"-api --timeout=5m
  kubectl -n "$NS" exec -i deploy/"$REL"-api -- koinon-api keys import --yes < koinon-kek-backup.yaml
  kubectl -n "$NS" scale deployment/"$REL"-api --replicas=0
  kubectl -n "$NS" wait --for=delete pod -l app.kubernetes.io/instance=$REL,app.kubernetes.io/component=api --timeout=5m
else
  kubectl -n "$NS" apply -f koinon-kek-backup.yaml
fi
# e1=restore-gateway-key
NS=${NS:-koinon}
REL=${REL:-koinon}
GWKEY=${GWKEY:-$REL-gateway-recipient-key}
# Run it after restore-db. The restored rows name the backup's keys, so the Secret becomes the backup: a new install's
# own first key has no row after restore-db. Without a backup file (no gateway key) there is nothing to do.
if test -f koinon-gateway-key-backup.yaml; then
  grep -qx "  name: $GWKEY" koinon-gateway-key-backup.yaml || { echo "koinon-gateway-key-backup.yaml is not the Secret $GWKEY" >&2; false; }
  AS=system:serviceaccount:$NS:${GWADMIN:-$REL-gateway-key-admin}
  if kubectl -n "$NS" get secret/"$GWKEY" > /dev/null 2>&1; then
    kubectl -n "$NS" replace --as="$AS" -f koinon-gateway-key-backup.yaml
  else
    kubectl -n "$NS" create --as="$AS" -f koinon-gateway-key-backup.yaml
  fi
fi
# e1=pipe-db
NS=${NS:-koinon}
REL=${REL:-koinon}
SRC_NS=${SRC_NS:?set SRC_NS to the source install's namespace}
SRC_REL=${SRC_REL:?set SRC_REL to the source install's release}
# Run it after stop and hold. The source keeps running; its database is read, never changed.
test "$SRC_NS/$SRC_REL" != "$NS/$REL" || { echo "the source is the target: it would be wiped before it is read" >&2; false; }
SRC_PRIMARY=$(kubectl -n "$SRC_NS" get pod -l cnpg.io/cluster=$SRC_REL-pg,cnpg.io/instanceRole=primary -o name)
PRIMARY=$(kubectl -n "$NS" get pod -l cnpg.io/cluster=$REL-pg,cnpg.io/instanceRole=primary -o name)
test -n "$SRC_PRIMARY" && test -n "$PRIMARY"
kubectl -n "$NS" exec "$PRIMARY" -c postgres -- psql --dbname=koinon -v ON_ERROR_STOP=1 \
  -c 'DROP SCHEMA IF EXISTS dbos CASCADE' -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public AUTHORIZATION pg_database_owner' -c 'GRANT USAGE ON SCHEMA public TO PUBLIC'
kubectl -n "$SRC_NS" exec "$SRC_PRIMARY" -c postgres -- pg_dump --format=custom --dbname=koinon | kubectl -n "$NS" exec -i "$PRIMARY" -c postgres -- pg_restore --dbname=koinon --exit-on-error
# e1=pipe-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
SRC_NS=${SRC_NS:?set SRC_NS to the source install's namespace}
SRC_REL=${SRC_REL:?set SRC_REL to the source install's release}
# Needs one koinon-api pod of the source. The target's koinon-api runs only for the import, as in restore-keys.
# Without a KEK Secret on the target, apply creates the Secret under the source's name: use the same release name then.
kubectl -n "$SRC_NS" exec deploy/"$SRC_REL"-api -- koinon-api keys status > /dev/null
if kubectl -n "$NS" get secret/"$REL"-kek > /dev/null 2>&1; then
  kubectl -n "$NS" scale deployment/"$REL"-api --replicas=1
  kubectl -n "$NS" rollout status deployment/"$REL"-api --timeout=5m
  kubectl -n "$SRC_NS" exec deploy/"$SRC_REL"-api -- koinon-api keys export | kubectl -n "$NS" exec -i deploy/"$REL"-api -- koinon-api keys import --yes
  kubectl -n "$NS" scale deployment/"$REL"-api --replicas=0
  kubectl -n "$NS" wait --for=delete pod -l app.kubernetes.io/instance=$REL,app.kubernetes.io/component=api --timeout=5m
else
  kubectl -n "$SRC_NS" exec deploy/"$SRC_REL"-api -- koinon-api keys export | kubectl -n "$NS" apply -f -
fi
# The gateway recipient key, as backup-gateway-key and restore-gateway-key do it, named after the target's Secret.
GWKEY=${GWKEY:-$REL-gateway-recipient-key}
SRC_GWKEY=${SRC_GWKEY:-$SRC_REL-gateway-recipient-key}
if kubectl -n "$SRC_NS" get secret/"$SRC_GWKEY" > /dev/null 2>&1; then
  AS=system:serviceaccount:$NS:${GWADMIN:-$REL-gateway-key-admin}
  verb=create
  if kubectl -n "$NS" get secret/"$GWKEY" > /dev/null 2>&1; then verb=replace; fi
  kubectl -n "$SRC_NS" get secret/"$SRC_GWKEY" -o go-template='apiVersion: v1{{"\n"}}kind: Secret{{"\n"}}metadata:{{"\n"}}  name: '"$GWKEY"'{{"\n"}}  labels:{{"\n"}}{{range $k, $v := .metadata.labels}}    {{$k}}: {{printf "%q" $v}}{{"\n"}}{{end}}type: Opaque{{"\n"}}data:{{"\n"}}{{range $k, $v := .data}}  {{$k}}: {{$v}}{{"\n"}}{{end}}' | kubectl -n "$NS" "$verb" --as="$AS" -f -
fi
# e1=start
NS=${NS:-koinon}
REL=${REL:-koinon}
# Each Deployment goes back to the replica count that stop noted in koinon-replicas.txt. The MCP credential format
# gate counts the copies: with fewer koinon-api, reconciler or koinon-mcp-gateway copies than the chart expects, new
# MCP credentials stay in envelope v1.
test -s koinon-replicas.txt || { echo "koinon-replicas.txt is missing: run stop in this directory first" >&2; false; }
replicas() { awk -v d="$1" '$1 == d {print $2}' koinon-replicas.txt; }
kubectl -n "$NS" scale deployment/"$REL"-api --replicas="$(replicas api)"
kubectl -n "$NS" scale deployment/"$REL"-reconciler --replicas="$(replicas reconciler)"
kubectl -n "$NS" rollout status deployment/"$REL"-api deployment/"$REL"-reconciler --timeout=5m
kubectl -n "$NS" scale deployment/"$REL"-agentd --replicas="$(replicas agentd)"
kubectl -n "$NS" rollout status deployment/"$REL"-agentd --timeout=5m
if kubectl -n "$NS" get deployment/"$REL"-mcp-gateway > /dev/null 2>&1; then
  kubectl -n "$NS" scale deployment/"$REL"-mcp-gateway --replicas="$(replicas mcp-gateway)"
fi
# e1=resync
NS=${NS:-koinon}
REL=${REL:-koinon}
kubectl -n "$NS" exec deploy/"$REL"-api -- koinon-api checkpoints resync --all
# e1=compare-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
# Every KEK the source listed is here with the same fingerprint, and the active KEK is the same (exits 1 otherwise).
# It needs one koinon-api pod, so run it while the install is up, or after restore-keys scales it for keys import.
kubectl -n "$NS" exec -i deploy/"$REL"-api -- koinon-api keys compare < koinon-keys-status.txt
# e1=verify-keys
NS=${NS:-koinon}
REL=${REL:-koinon}
kubectl -n "$NS" exec deploy/"$REL"-api -- koinon-api keys verify
# e1=verify-gateway-key
NS=${NS:-koinon}
REL=${REL:-koinon}
# koinon-mcp-gateway is ready only when it holds the private key of every key row that is not retired and each
# matches its public row: then every MCP credential sealed to those keys opens. It prints no key material.
if kubectl -n "$NS" get deployment/"$REL"-mcp-gateway > /dev/null 2>&1; then
  kubectl -n "$NS" rollout status deployment/"$REL"-mcp-gateway --timeout=5m
fi
# e1=release
NS=${NS:-koinon}
REL=${REL:-koinon}
kubectl -n "$NS" set env deployment/"$REL"-api deployment/"$REL"-reconciler deployment/"$REL"-agentd KOINON_RESTORE_HOLD-
kubectl -n "$NS" rollout status deployment/"$REL"-api deployment/"$REL"-reconciler deployment/"$REL"-agentd --timeout=5m
