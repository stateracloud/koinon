#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# koinon-opencode starts OpenCode as an ACP agent on stdin/stdout. It is the flavor's entry
# point: koinon-agentd runs it through OpenShell's non-TTY exec (ADR 0049).
#
# Usage:
#   koinon-opencode --model-base-url URL --model NAME --mcp-url URL [--plugin-installs]
#                   [--model-format openai|anthropic] [--cache-anthropic | --cache-alibaba]
#                   [--thinking none|default|adaptive-summarized|disabled|effort-none]
#                   [--session-id ID] [--no-web-tools]
#                   [--model-tries N] [--model-retry-backoff-ms MS] [--model-max-retry-after-ms MS]
#                   [-- OPENCODE_ACP_ARGS...]
#
# --model-tries, --model-retry-backoff-ms and --model-max-retry-after-ms are Koinon's retry policy
# for a failed model request, which koinon-agentd always passes (ADR 0056 amendment 2026-10-31,
# point 3): OpenCode is the one layer that retries, and Koinon's plugin
# /usr/local/lib/koinon/opencode/plugins/koinon-retry makes it follow the policy, not its own.
#
# --plugin-installs is set by koinon-agentd when the agent's template turns
# harness.pluginInstalls on; only then are the agent's own plugins loaded (see README.md).
#
# --no-web-tools is set by koinon-agentd for an agent whose sandbox has no web egress
# (agentconfig.Config.WebEgress, ADR 0080): OpenCode's built-in webfetch is then denied by a
# permission rule, which removes it from the tools the model is offered. (Web search is off for
# everyone: plugins -opencode.websearch.* and -opencode.tool.websearch in the config.)
#
# --model-format is the model's wire format (ADR 0069), openai (chat completions) by default.
# It picks the provider entry of opencode.jsonc: koinon for openai, koinon-anthropic for anthropic
# (Messages). koinon-agentd selects the same entry for the session's model, from the flavor
# table in internal/harness.
#
# --thinking is the thinking form koinon-agentd decided for the run from the model's catalog row
# and the agent's setting (internal/thinking, ADR 0069 amendments 2026-10-29 and 2026-10-31). OpenCode
# 2.2.0 would decide from the model's ID, so the config always states it, and on and off are both
# sent explicitly: adaptive-summarized is thinking {"type":"adaptive","display":"summarized"} and
# disabled is thinking {"type":"disabled"} (anthropic format); effort-none is reasoning
# {"effort":"none"} (openai format); default and none, or no switch, send no thinking field (default:
# the model thinks by its own default; none: it does not think).
#
# --cache-anthropic and --cache-alibaba are set by koinon-agentd for a model whose provider needs
# explicit prompt-cache markers on chat completions (ADR 0068); the config then sets
# compatibility.cacheFormat. They apply to the openai format only: an anthropic-format model
# gets its markers from OpenCode itself.
#
# koinon-agentd writes the run's instructions to /sandbox/.koinon/AGENTS.md before it starts
# this script; without that file the script refuses to start (exit 64).
#
# OpenShell does not pass the image's ENV to the processes it starts, PATH included (ADR 0048),
# so everything OpenCode needs is set here and binaries are called by absolute path. The
# per-agent values come as arguments, are checked, exported as KOINON_* variables and read by
# /etc/koinon/opencode/opencode.jsonc through OpenCode's {env:...} substitution. The model key
# is never an argument: it arrives as $OPENAI_API_KEY, which in a sandbox is an OpenShell
# placeholder that the proxy swaps for the real key on the way to agentgateway.
set -eu

KOINON_FLAVOR=opencode
# The shared helpers (flavors/common/koinon-entry-lib.sh, copied to /usr/local/lib/koinon/ by
# the Dockerfile): koinon_die, argument parsing, the instruction-file check.
# shellcheck source=../common/koinon-entry-lib.sh
. /usr/local/lib/koinon/koinon-entry-lib.sh

# OpenCode substitutes {env:...} values into the config text before parsing it as JSON, so a
# value must not be able to break out of its string.
check() {
  case $2 in
    '' | *'"'* | *'\'* | *'{'* | *'}'* | *[[:space:][:cntrl:]]*) koinon_die "invalid $1: '$2'" ;;
  esac
}

# --plugin-installs is the one switch only this flavor takes.
plugin_installs=''
cache_format=''
no_web_tools=''
koinon_extra_arg() {
  case $1 in
    --plugin-installs) plugin_installs=1 ;;
    --no-web-tools) no_web_tools=1 ;;
    --cache-anthropic) cache_format=anthropic ;;
    --cache-alibaba) cache_format=alibaba ;;
    *) return 1 ;;
  esac
}

koinon_parse_args "$@"
shift "$koinon_shift"

# The provider entry for the model's format: one row per format. This case and ModelEntries in
# internal/harness/harness.go are the two places to add a row; test/flavors checks that they agree.
case $model_format in
  openai) entry=koinon ;;
  anthropic) entry=koinon-anthropic ;;
  *) koinon_die "no provider entry for --model-format '$model_format'" ;;
esac
if [ -n "$cache_format" ] && [ "$model_format" != openai ]; then
  koinon_die "--cache-$cache_format applies to the openai model format only"
fi
# Koinon's retry plugin can shorten OpenCode 2.2.0's schedule of 10 retries but not lengthen it
# (packages/core/src/model-retry.ts asks the session.retry hook only while that schedule runs).
[ "$model_tries" -le 11 ] || koinon_die "--model-tries must be at most 11 for OpenCode: '$model_tries'"

# Drop anything the caller's environment might carry that would change where OpenCode reads its
# configuration, its database or its server credentials, or where it sends telemetry
# (OpenCode 2.2.0, see README.md).
for koinon_var in $(env | sed -n 's/^\(OPENCODE_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$koinon_var"
done
unset koinon_var TMPDIR \
  OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_HEADERS

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The agent's python3 scripts must not leave __pycache__ directories in the repository it works
# on (the image's standard library is precompiled and read-only).
export PYTHONDONTWRITEBYTECODE=1
# State lives in the sandbox home, which is the agent's volume (ADR 0048, 0049).
koinon_export_base_env
export XDG_DATA_HOME=/sandbox/.local/share
export XDG_STATE_HOME=/sandbox/.local/state
export XDG_CONFIG_HOME=/sandbox/.config
# OpenCode's global config directory: read-only in the image, so neither the agent nor a
# repository can change it.
export OPENCODE_CONFIG_DIR=/etc/koinon/opencode

# No update check and no model catalog download; the repository the agent works on must not
# reconfigure the harness (no opencode.json(c), .opencode/, AGENTS.md from the session
# directory upward), so only /etc/koinon/opencode applies (see README.md).
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_MODELS_FETCH=1
export OPENCODE_DISABLE_PROJECT_CONFIG=1
# No .claude roots (skills; the compatibility plugin is also off) and none of the free models
# of OpenCode's built-in provider: the koinon provider is the only one.
export OPENCODE_DISABLE_CLAUDE_CODE=1
export OPENCODE_DISABLE_FREE_MODELS=1

# The agent's own plugins load only when the template allows plugin installs. The global config
# directory is read-only and holds none, project configuration is off and ~/.config/opencode is
# no config directory here, so the only way in is this list: each directory under
# ~/.config/opencode/plugins/, merged into the config as OPENCODE_CONFIG_CONTENT.
config_content=''
if [ -n "$plugin_installs" ]; then
  list=''
  for d in /sandbox/.config/opencode/plugins/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    check plugin "$d"
    list="$list${list:+,}\"$d\""
  done
  config_content="\"plugins\":[$list]"
fi
# Thinking (ADR 0069 amendments 2026-10-29 and 2026-10-31). OpenCode 2.2.0 gives every Messages
# request a default thinking block, adaptive with block_binding, when the model's ID parses as Claude
# 5.1 or later (packages/ai/src/protocols/anthropic-messages.ts applyThinkingBindingDefault,
# claude-model.ts), and pairs it with a beta the gateway would otherwise strip. Koinon decides
# instead. The model-level compatibility flags that override the ID heuristic (packages/schema/src/
# model-compatibility.ts) switch OpenCode's own block off: supportsThinkingBlockBinding false sends
# no thinking field, and supportsEffortUpdates false keeps output_config and its beta out, as
# Koinon does not use per-turn effort. The model's key is the plain name the entry's static model
# entry uses (opencode.jsonc), so the overlay merges into it. The thinking field itself is Koinon's
# exact form, in the provider-level body overlay below (the same mechanism as session_id), so the
# request carries it whatever OpenCode would have chosen.
case $model_format in
  anthropic)
    models="\"models\":{\"$model\":{\"compatibility\":{\"supportsThinkingBlockBinding\":false,\"supportsEffortUpdates\":false}}}"
    ;;
  *)
    models=''
    ;;
esac
case $thinking in
  adaptive-summarized) thinking_body='"thinking":{"type":"adaptive","display":"summarized"}' ;;
  disabled) thinking_body='"thinking":{"type":"disabled"}' ;;
  effort-none) thinking_body='"reasoning":{"effort":"none"}' ;;
  *) thinking_body='' ;;
esac
# No web egress (ADR 0080): deny the built-in webfetch for everyone, the explore subagent included
# (the top-level rules are appended to every agent's). A denied tool is not offered to the model.
if [ -n "$no_web_tools" ]; then
  config_content="$config_content${config_content:+,}\"permissions\":[{\"action\":\"webfetch\",\"resource\":\"*\",\"effect\":\"deny\"}]"
fi
# Prompt caching (ADR 0068): the openai entry's models send Anthropic-style cache_control
# markers. The key is compatibility.cacheFormat (packages/schema/src/model-compatibility.ts,
# provider level in packages/schema/src/config/provider.ts).
# Sticky routing: the run ID goes to OpenRouter as the body field session_id, so the run stays on
# one upstream and its cache stays warm. The provider-level body overlay is merged into every
# request of the entry in use, in either format (packages/schema/src/config/provider.ts,
# core/src/config/plugin/provider.ts); the thinking field above rides in it too.
provider=''
if [ -n "$cache_format" ]; then
  provider="\"compatibility\":{\"cacheFormat\":\"$cache_format\"}"
fi
body=''
if [ -n "$session_id" ]; then
  body="\"session_id\":\"$session_id\""
fi
if [ -n "$thinking_body" ]; then
  body="$body${body:+,}$thinking_body"
fi
if [ -n "$body" ]; then
  provider="$provider${provider:+,}\"body\":{$body}"
fi
if [ -n "$models" ]; then
  provider="$provider${provider:+,}$models"
fi
if [ -n "$provider" ]; then
  config_content="$config_content${config_content:+,}\"providers\":{\"$entry\":{$provider}}"
fi
# The config file's default model is koinon/<model>; another entry names its own, so that a session
# that does not select a model (koinon-agentd always does) still starts on the right provider.
if [ "$entry" != koinon ]; then
  config_content="\"model\":\"$entry/$model\"${config_content:+,}$config_content"
fi
if [ -n "$config_content" ]; then
  export OPENCODE_CONFIG_CONTENT="{$config_content}"
fi

# The agentgateway key under a name no built-in OpenCode provider reads: with OPENAI_API_KEY
# set, OpenCode's built-in openai provider activates on its own.
export KOINON_MODEL_KEY="${OPENAI_API_KEY:-}"
unset OPENAI_API_KEY
koinon_export_endpoints
# Koinon's retry policy, the options of the koinon.retry plugin in opencode.jsonc (see README.md,
# "Model retries"): OpenCode's own schedule never decides.
export KOINON_MODEL_TRIES="$model_tries"
export KOINON_MODEL_RETRY_BACKOFF_MS="$model_retry_backoff_ms"
export KOINON_MODEL_MAX_RETRY_AFTER_MS="$model_max_retry_after_ms"

# opencode acp talks to its own server (opencode serve --stdio --port 0 on 127.0.0.1) over HTTP;
# that traffic must not go to the sandbox proxy.
export NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"
export no_proxy="127.0.0.1,localhost${no_proxy:+,$no_proxy}"

# Koinon's instructions reach the model only through this file (the "instructions" key in
# /etc/koinon/opencode/opencode.jsonc). OpenCode skips a missing file silently and loads an empty
# one as empty instructions.
koinon_require_instructions

mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
exec /usr/local/bin/opencode acp "$@"
