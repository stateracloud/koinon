#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# koinon-opencode starts OpenCode as an ACP agent on stdin/stdout. It is the flavor's entry
# point: koinon-agentd runs it through OpenShell's non-TTY exec (ADR 0049).
#
# Usage:
#   koinon-opencode --model-base-url URL --model NAME --mcp-url URL [--plugin-installs]
#                   [-- OPENCODE_ACP_ARGS...]
#
# --plugin-installs is set by koinon-agentd when the agent's template turns
# harness.pluginInstalls on; only then are external plugins loaded (see README.md).
#
# OpenShell does not pass the image's ENV to the processes it starts, PATH included (ADR 0048),
# so everything OpenCode needs is set here and binaries are called by absolute path. The
# per-agent values come as arguments, are checked, exported as KOINON_* variables and read by
# /etc/koinon/opencode/opencode.jsonc through OpenCode's {env:...} substitution. The model key
# is never an argument: OpenCode reads $OPENAI_API_KEY, which in a sandbox is an OpenShell
# placeholder that the proxy swaps for the real key on the way to agentgateway.
set -eu

die() {
  echo "koinon-opencode: $*" >&2
  exit 64
}

# OpenCode substitutes {env:...} values into the config text before parsing it as JSON, so a
# value must not be able to break out of its string.
check() {
  case $2 in
    '' | *'"'* | *'\'* | *'{'* | *'}'* | *[[:space:][:cntrl:]]*) die "invalid $1: '$2'" ;;
  esac
}

check_url() {
  check "$1" "$2"
  case $2 in
    http://?* | https://?*) ;;
    *) die "$1 must be an http or https URL: '$2'" ;;
  esac
}

base_url='' model='' mcp_url='' plugin_installs=''
while [ $# -gt 0 ]; do
  case $1 in
    --model-base-url) [ $# -ge 2 ] || die "$1 needs a value"; base_url=$2; shift 2 ;;
    --model) [ $# -ge 2 ] || die "$1 needs a value"; model=$2; shift 2 ;;
    --mcp-url) [ $# -ge 2 ] || die "$1 needs a value"; mcp_url=$2; shift 2 ;;
    --plugin-installs) plugin_installs=1; shift ;;
    --) shift; break ;;
    *) die "unknown argument '$1'" ;;
  esac
done
check_url --model-base-url "$base_url"
check --model "$model"
check_url --mcp-url "$mcp_url"

# Drop anything the caller's environment might carry that would change where OpenCode reads its
# configuration or sends telemetry.
unset OPENCODE_CONFIG OPENCODE_CONFIG_DIR OPENCODE_CONFIG_CONTENT OPENCODE_PERMISSION \
  OPENCODE_MODELS_URL OPENCODE_MODELS_PATH OPENCODE_AUTO_SHARE \
  OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_HEADERS

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=C.UTF-8
# State lives in the sandbox home, which is the agent's volume (ADR 0048, 0049).
export HOME=/sandbox
export XDG_DATA_HOME=/sandbox/.local/share
export XDG_STATE_HOME=/sandbox/.local/state
export XDG_CACHE_HOME=/sandbox/.cache
# OpenCode's global config directory is $XDG_CONFIG_HOME/opencode, so this makes
# /etc/koinon/opencode the global config. It is read-only, which also stops OpenCode from
# installing @opencode-ai/plugin from npm into it (it skips unwritable directories).
export XDG_CONFIG_HOME=/etc/koinon

# Phone-home and download switches (OpenCode 1.19.3, see README.md for the source of each).
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_MODELS_FETCH=1
export OPENCODE_DISABLE_LSP_DOWNLOAD=1
export OPENCODE_DISABLE_DEFAULT_PLUGINS=1
# External plugins (the agent's ~/.opencode/plugin(s) and the npm plugins its ~/.opencode config
# names) load only when the template allows plugin installs; the reconciler then also opens
# read-only npm registry access for /usr/local/bin/opencode, which installs them in-process.
if [ -z "$plugin_installs" ]; then
  export OPENCODE_PURE=1
else
  unset OPENCODE_PURE
fi
export OPENCODE_DISABLE_CLAUDE_CODE=1

# The repository the agent works on must not reconfigure the harness: no opencode.json(c) or
# .opencode/ (agents, commands, permissions, instructions) from the session directory upward,
# so only /etc/koinon/opencode applies (see README.md).
export OPENCODE_DISABLE_PROJECT_CONFIG=1

export KOINON_MODEL_BASE_URL="$base_url"
export KOINON_MODEL="$model"
export KOINON_MCP_URL="$mcp_url"

mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
exec /usr/local/bin/opencode acp "$@"
