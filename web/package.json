{
  "name": "koinon-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:isolated": "VITEST_ISOLATE=true vitest run",
    "test:e2e": "playwright test",
    "test:e2e-drill": "playwright test -c playwright.drill.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "^2.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0"
