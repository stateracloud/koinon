{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Koinon chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "map": {"type": "object"},
    "pullSecrets": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/definitions/nonEmpty"},
          {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"$ref": "#/definitions/nonEmpty"}}
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object"},
        "limits": {"type": "object"},
        "claims": {"type": "array"}
      }
    },
    "koinonImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"$ref": "#/definitions/nonEmpty"},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas"],
      "properties": {
        "image": {"$ref": "#/definitions/koinonImage"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "resources": {"$ref": "#/definitions/resources"},
        "podAnnotations": {"$ref": "#/definitions/map"},
        "nodeSelector": {"$ref": "#/definitions/map"},
        "tolerations": {"type": "array"},
        "affinity": {"$ref": "#/definitions/map"}
      }
    },
    "flavor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {"image": {"$ref": "#/definitions/koinonImage"}}
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "key": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "peers": {
      "description": "NetworkPolicyPeer list.",
      "type": "array",
      "items": {"type": "object"}
    },
    "identities": {
      "description": "Kubernetes usernames, for example system:serviceaccount:<namespace>:<name>.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/nonEmpty"}
    }
  },
  "properties": {
    "clusterDomain": {"$ref": "#/definitions/nonEmpty"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imagePullSecrets": {"$ref": "#/definitions/pullSecrets"},
        "imageRegistry": {"type": "string", "pattern": "^([^/\\s:]+(:[0-9]+)?(/[^\\s:]+)*)?$"},
        "registryMirrors": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "pattern": "^[^/\\s:]+(:[0-9]+)?(/[^\\s:]+)*$"}
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {"$ref": "#/definitions/nonEmpty"},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"$ref": "#/definitions/pullSecrets"},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "port", "otlpPort", "toolsPort", "savedWorkPort", "guardPort", "leakGuardByteCap"],
      "properties": {
        "image": {"$ref": "#/definitions/koinonImage"},
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "otlpPort": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "the internal OTLP/HTTP receiver for agentgateway's access log and agentd's run spans"},
        "otlpToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"existingSecret": {"type": "string"}}
        },
        "otlpTracesToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"existingSecret": {"type": "string"}}
        },
        "toolsPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "savedWorkPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "guardPort": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "the MCP leak guard (ExtMcp gRPC), reachable only from agentgateway (ADR 0091)"},
        "leakGuardByteCap": {"type": "integer", "minimum": 1, "description": "bytes of external-low payload a run may send once its session holds both legs (ADR 0091)"},
        "durable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        },
        "resources": {"$ref": "#/definitions/resources"},
        "podAnnotations": {"$ref": "#/definitions/map"},
        "nodeSelector": {"$ref": "#/definitions/map"},
        "tolerations": {"type": "array"},
        "affinity": {"$ref": "#/definitions/map"}
      }
    },
    "reconciler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas"],
      "properties": {
        "image": {"$ref": "#/definitions/koinonImage"},
        "replicas": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/definitions/resources"},
        "podAnnotations": {"$ref": "#/definitions/map"},
        "nodeSelector": {"$ref": "#/definitions/map"},
        "tolerations": {"type": "array"},
        "affinity": {"$ref": "#/definitions/map"},
        "idleTimeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "parkWarm": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "archiveAfter": {"type": "string", "pattern": "^-?([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "sandboxJobs": {"type": "integer", "minimum": 1},
        "keepWarmPerOrg": {"type": "integer"},
        "maxRecreatesPerPass": {"type": "integer"},
        "resyncInterval": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "homeRetention": {"enum": ["delete", "retain"]}
      }
    },
    "agentd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas"],
      "properties": {
        "image": {"$ref": "#/definitions/koinonImage"},
        "replicas": {"type": "integer", "minimum": 0},
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"maxUnavailable": {"type": "integer", "minimum": 1}}
        },
        "workers": {"type": "integer", "minimum": 1},
        "lease": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "drainDeadlineSeconds": {"type": "integer", "minimum": 1},
        "gatewayURL": {"type": "string", "pattern": "^(https?://[^\\s@?#]+)?$"},
        "resources": {"$ref": "#/definitions/resources"},
        "podAnnotations": {"$ref": "#/definitions/map"},
        "nodeSelector": {"$ref": "#/definitions/map"},
        "tolerations": {"type": "array"},
        "affinity": {"$ref": "#/definitions/map"}
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "wait": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "openshell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"$ref": "#/definitions/nonEmpty"},
            "configMap": {"$ref": "#/definitions/nonEmpty"},
            "workload": {"$ref": "#/definitions/nonEmpty"}
          }
        },
        "agentSandbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"$ref": "#/definitions/nonEmpty"},
            "controller": {"$ref": "#/definitions/nonEmpty"}
          }
        },
        "agentgateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"$ref": "#/definitions/nonEmpty"},
            "controller": {"$ref": "#/definitions/nonEmpty"},
            "xdsPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "seccompProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "timeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"}
          }
        },
        "networkPolicyProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "timeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"}
          }
        },
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["cnpg", "external"]},
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instances": {"type": "integer", "minimum": 1},
            "nodeMaintenanceWindow": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inProgress": {"type": "boolean"},
                "reusePVC": {"type": "boolean"}
              }
            },
            "imageName": {"$ref": "#/definitions/nonEmpty"},
            "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {"$ref": "#/definitions/nonEmpty"},
                "storageClass": {"type": "string"}
              }
            },
            "resources": {"$ref": "#/definitions/resources"},
            "operatorNamespace": {"$ref": "#/definitions/nonEmpty"},
            "existingSecrets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "migrate": {"type": "string"},
                "api": {"type": "string"},
                "reconciler": {"type": "string"},
                "agentd": {"type": "string"}
              }
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {"type": "string"},
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["migrate", "api", "reconciler", "agentd"],
              "properties": {
                "migrate": {"$ref": "#/definitions/nonEmpty"},
                "api": {"$ref": "#/definitions/nonEmpty"},
                "reconciler": {"$ref": "#/definitions/nonEmpty"},
                "agentd": {"$ref": "#/definitions/nonEmpty"}
              }
            }
          }
        }
      },
      "if": {"properties": {"mode": {"const": "external"}}},
      "then": {
        "properties": {
          "external": {"required": ["secretName"], "properties": {"secretName": {"minLength": 1}}}
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["standalone", "kubernetes"]},
        "standalone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag"],
              "properties": {
                "repository": {"$ref": "#/definitions/nonEmpty"},
                "tag": {"$ref": "#/definitions/nonEmpty"},
                "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
              }
            },
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "sessionKey": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"existingSecret": {"type": "string"}}
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {"$ref": "#/definitions/nonEmpty"},
                "storageClass": {"type": "string"}
              }
            },
            "resources": {"$ref": "#/definitions/resources"},
            "podAnnotations": {"$ref": "#/definitions/map"},
            "nodeSelector": {"$ref": "#/definitions/map"},
            "tolerations": {"type": "array"},
            "affinity": {"$ref": "#/definitions/map"}
          }
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gatewayClassName": {"$ref": "#/definitions/nonEmpty"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiUrl": {"type": "string", "pattern": "^https?://[^/]+(/.*)?$"}
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedInternalHosts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedInternalHosts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrateLegacyConnections": {"type": "boolean"},
        "kek": {
          "description": "Key-encryption keys for stored provider keys and connection secrets (ADR 0056).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "guard": {
              "description": "Admission policies that guard the KEK Secret and the reconciler's Secret writes (issue #604).",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "extraWriters": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            },
            "activePeriod": {"type": "string", "pattern": "^[0-9]+(h|m|s)$"},
            "kms": {
              "description": "Wrapping the KEKs with a KMS (ADR 0085 decision 12); local by default.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "backend": {"enum": ["local", "openbao", "awskms"]},
                "awskms": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "region": {"type": "string", "pattern": "^(|[a-z]{2}(-[a-z]+)+-[0-9]{1,2})$"},
                    "keyId": {"type": "string", "pattern": "^(|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|mrk-[0-9a-f]{32}|alias/[A-Za-z0-9/_-]{1,250}|arn:aws[a-z-]*:kms:[a-z0-9-]+:[0-9]{12}:(key|alias)/[A-Za-z0-9/_-]+)$"},
                    "endpoint": {"type": "string", "pattern": "^(|https?://[^\\s/]+/?)$"},
                    "stsEndpoint": {"type": "string", "pattern": "^(|https?://[^\\s/]+/?)$"},
                    "caConfigMap": {"type": "string"},
                    "roleArns": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "api": {"type": "string", "pattern": "^(|arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@/_-]+)$"},
                        "reconciler": {"type": "string", "pattern": "^(|arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@/_-]+)$"},
                        "keyAdmin": {"type": "string", "pattern": "^(|arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@/_-]+)$"}
                      }
                    },
                    "timeout": {"type": "string", "pattern": "^(|[0-9]+(ms|s|m))$"}
                  }
                },
                "openbao": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "address": {"type": "string", "pattern": "^(|https?://[^\\s/]+/?)$"},
                    "caConfigMap": {"type": "string"},
                    "namespace": {"type": "string"},
                    "transitMount": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"},
                    "key": {"type": "string", "pattern": "^(|[A-Za-z0-9_.-]{1,128})$"},
                    "authMount": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"},
                    "roles": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "api": {"type": "string", "minLength": 1},
                        "reconciler": {"type": "string", "minLength": 1},
                        "keyAdmin": {"type": "string", "minLength": 1}
                      }
                    },
                    "timeout": {"type": "string", "pattern": "^(|[0-9]+(ms|s|m))$"}
                  }
                },
                "keyAdmin": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "addKey": {"type": "string", "pattern": "^(|[a-z0-9]([a-z0-9._-]{0,60}[a-z0-9])?)$", "not": {"const": "active"}, "description": "A KEK ID to add; \"active\" is the keyring's pointer, not an ID."},
                    "activateIfNoActive": {"type": "boolean", "description": "With addKey: make the added KEK active when the KEK Secret has no usable active KEK (recovery from a lost KMS key that wrapped it)."},
                    "rewrapUnbound": {"type": "boolean", "description": "Bind the KEKs wrapped before old issue 615 to the install ID; a binary older than old issue 615 cannot read them then."},
                    "resources": {"type": "object"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": ["boolean", "null"]},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
            "maxChangePercent": {"type": ["integer", "null"], "minimum": 1, "maximum": 25},
            "maxAutoPerDay": {"type": ["integer", "null"], "minimum": 1, "maximum": 10}
          }
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "bucket": {"type": "string"},
            "pathStyle": {"type": "boolean"}
          }
        },
        "interval": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "scratchSize": {"type": "string"}
      }
    },
    "flavors": {
      "description": "Flavor images (ADR 0035). Agents of a flavor without an image are reported as reconcile errors.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opencode": {"$ref": "#/definitions/flavor"}
      }
    },
    "flavorPrepull": {
      "description": "Pre-pull the flavor images on the Kata nodes (plan item LT1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "nodeSelector": {"$ref": "#/definitions/map"},
        "tolerations": {"type": "array"},
        "pauseImage": {"$ref": "#/definitions/nonEmpty"},
        "priorityClassName": {"type": "string"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "openshell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {"type": "string"},
        "clientTLSSecret": {"type": "string"},
        "insecure": {"type": "boolean"},
        "runtimeClassName": {"$ref": "#/definitions/nonEmpty"},
        "gatewayId": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"cpu": {"type": "object", "additionalProperties": false, "properties": {"request": {"type": ["string", "number"]}, "limit": {"type": ["string", "number"]}}}, "memory": {"type": "object", "additionalProperties": false, "properties": {"request": {"type": ["string", "number"]}, "limit": {"type": ["string", "number"]}}}}
            },
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {"type": "object", "additionalProperties": false, "properties": {"request": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": ["string", "number"]}, "max": {"type": ["string", "number"]}}}, "limit": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": ["string", "number"]}, "max": {"type": ["string", "number"]}}}}},
                "memory": {"type": "object", "additionalProperties": false, "properties": {"request": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": ["string", "number"]}, "max": {"type": ["string", "number"]}}}, "limit": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": ["string", "number"]}, "max": {"type": ["string", "number"]}}}}}
              }
            },
            "memoryRequestEqualsLimit": {"type": "boolean"}
          }
        }
      }
    },
    "sandboxObserver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "sandboxNetworkPolicy": {
      "description": "Default-deny NetworkPolicy for OpenShell sandbox namespaces (spike 8.15). On by default; standard networking.k8s.io/v1 only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "sandboxLimitRange": {
      "description": "LimitRange for OpenShell sandbox namespaces (#76). On by default; sizes supervisor and init containers.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "restoreHold": {"type": "boolean"},
    "publicUrl": {"type": "string", "pattern": "^(https?://[^/?#\\s]+/?)?$"},
    "installMark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"}
      }
    },
    "bootstrapAdmin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "username": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^\\S(.*\\S)?$"},
        "existingSecret": {"type": "string"}
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "issuerUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
        "clientId": {"type": "string"},
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "key": {"$ref": "#/definitions/nonEmpty"}
          }
        },
        "redirectUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
        "scopes": {"type": "array", "items": {"type": "string", "pattern": "^[^,\\s]+$"}},
        "groupsClaim": {"$ref": "#/definitions/nonEmpty"},
        "platformAdminGroups": {"type": "array", "items": {"type": "string", "pattern": "^[^,]+$"}},
        "groupMappings": {
          "type": "object",
          "propertyNames": {"pattern": "^[^,=]+$"},
          "additionalProperties": {"enum": ["viewer", "member", "admin", "owner"]}
        },
        "defaultOrgIdentityMode": {"enum": ["platform", "idp", "hybrid"]}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {
        "required": ["issuerUrl", "clientId"],
        "properties": {"issuerUrl": {"minLength": 1}, "clientId": {"minLength": 1}}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleTimeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "maxLifetime": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["host"], "properties": {"host": {"minLength": 1}}}
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hostnames": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "parentRefs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
          "group": {"type": "string"}, "kind": {"type": "string"}, "name": {"type": "string", "minLength": 1},
          "namespace": {"type": "string"}, "sectionName": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}},
        "timeouts": {"type": "object", "additionalProperties": false, "properties": {"request": {"type": "string"}, "backendRequest": {"type": "string"}}}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["hostnames", "parentRefs"], "properties": {"hostnames": {"minItems": 1}, "parentRefs": {"minItems": 1}}}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "allowFrom": {"$ref": "#/definitions/peers"},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "skipCapabilityCheck": {"type": "boolean"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}},
            "interval": {"type": "string", "pattern": "^([0-9]+(ms|s|m|h))*$"}
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "skipCapabilityCheck": {"type": "boolean"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}},
            "durableStrandedFor": {"type": "string", "pattern": "^([0-9]+(ms|s|m|h))+$"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "apiFrom": {"$ref": "#/definitions/peers"},
        "metricsFrom": {"$ref": "#/definitions/peers"},
        "gatewayEgressTo": {"type": "array", "items": {"type": "object"}}
      }
    },
    "sandboxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "scopeToGateway": {"type": "boolean", "description": "Add openshell.ai/gateway-id=<openshell.gatewayId> to the namespace selector."},
        "namespaceSelector": {
          "description": "LabelSelector for OpenShell sandbox namespaces.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "matchLabels": {"type": "object", "additionalProperties": {"type": "string"}},
            "matchExpressions": {"type": "array"}
          }
        },
        "runtimeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "RuntimeClass names the sandbox policy admits for workload pods (ADR 0075). Any other class is refused by the policy itself.",
          "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
        },
        "supervisorImages": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "supervisorTokenMaxSeconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400,
          "description": "Longest expirationSeconds the policy admits for the projected openshell-gateway ServiceAccount token on supervisor pods (ADR 0006)."
        },
        "validationActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["Deny", "Warn", "Audit"]}
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pods", "sandboxes", "secrets"],
          "properties": {
            "pods": {"$ref": "#/definitions/identities"},
            "supervisorPods": {"$ref": "#/definitions/identities"},
            "sandboxes": {"$ref": "#/definitions/identities"},
            "secrets": {"$ref": "#/definitions/identities"},
            "namespaces": {"$ref": "#/definitions/identities"}
          }
        }
      }
    }
  }
}
