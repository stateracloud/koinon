#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# koinon-git-credential is git's credential helper in every harness image. It answers for one host,
# github.com unless `--host HOST[:PORT]` says otherwise: /etc/koinon/git/config configures it for
# github.com, and the config koinon-agentd renders from a connection's host (internal/codehost,
# /sandbox/.koinon/git/config) configures it for that host, for example a GitHub Enterprise
# Server. For `get` it answers with the GitHub provider's
# placeholder from $GITHUB_TOKEN (or $GH_TOKEN), which OpenShell puts in the sandbox's
# environment; git sends it as the Basic password and OpenShell's proxy swaps it for the
# installation token on the wire (connectors/README.md). The placeholder is never written
# anywhere: `store` and `erase` do nothing, and without a placeholder git gets no answer and
# falls through (and fails, as an unauthenticated clone of a private repository should).
#
# The helper protocol: git writes key=value lines ending with a blank line on stdin.
set -eu

allowed=github.com
while [ $# -gt 1 ]; do
  case $1 in
    --host) [ $# -ge 3 ] || exit 0; allowed=$2; shift 2 ;;
    *) exit 0 ;;
  esac
done
[ "${1:-}" = get ] || exit 0

protocol='' host=''
while IFS= read -r line; do
  [ -n "$line" ] || break
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done

# Only the configured host over HTTPS: the config scopes the helper to https://HOST already.
[ "$protocol" = https ] && [ "$host" = "$allowed" ] || exit 0

token=${GITHUB_TOKEN:-${GH_TOKEN:-}}
[ -n "$token" ] || exit 0
# A value with a line break could add fields to the answer.
case $token in
  *[[:cntrl:]]*) echo "koinon-git-credential: GITHUB_TOKEN holds control characters; ignored" >&2; exit 0 ;;
esac

printf 'username=x-access-token\npassword=%s\n' "$token"
