// SPDX-License-Identifier: Apache-2.0
//
// OpenCode 2.2.6 configuration for the Koinon OpenCode harness. Read-only in the image at
// /etc/koinon/opencode/opencode.jsonc, which is OpenCode's global config because koinon-opencode
// sets OPENCODE_CONFIG_DIR=/etc/koinon/opencode. The KOINON_* values come from koinon-opencode's
// arguments; KOINON_MODEL_KEY is the agent's agentgateway key, an OpenShell placeholder inside a
// sandbox. See harnesses/opencode/README.md.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "koinon/{env:KOINON_MODEL}",
  "update": "disable",
  "share": "disabled",
  // No formatters. The key is "formatter" (packages/schema/src/config.ts:70), a boolean or a record
  // per formatter (packages/schema/src/config/formatter.ts:13). With none set no built-in is
  // registered (packages/core/src/config/plugin/formatter.ts:30-31), and a boolean resets what
  // earlier documents set (:64-67). The image holds no formatter (no uv, no ruff); this keeps it
  // that way if one is added. Nothing may download one: `uv format` fetches Ruff.
  "formatter": false,
  // Koinon's instructions for the run: koinon-agentd writes this file before every harness start
  // and restores it before every prompt. An absolute path only, never a URL (OpenCode fetches
  // those).
  "instructions": ["/sandbox/.koinon/AGENTS.md"],
  // OpenCode 2.2.0 dropped the built-in "ask" for external_directory (2.0.24 asked for every path
  // outside the session directory; its docs still say it does), so a read or edit outside it ran
  // without a question. Ask again, except for the places OpenCode itself writes to, which 2.0.24
  // exempted: truncated tool and shell output in the data directory, its temporary directory and
  // this config directory. Later rules win. The top-level rules are appended to every agent,
  // explore included, after its own; the explore block below repeats them as defence in depth.
  // Tool results over these limits are cut to their start; the full text goes to the tool-output
  // directory allowed below, for the agent to page through (OpenCode 2.2.0 defaults: 51200 bytes,
  // 2000 lines; packages/schema/src/config/tool-output.ts). About 6k tokens per result at most,
  // which keeps a run's re-sent history small (issue #22).
  "tool_output": { "max_bytes": 24576, "max_lines": 600 },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/sandbox/.local/share/opencode/shell/*/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/sandbox/.local/share/opencode/tool-output/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/koinon/opencode/*", "effect": "allow" },
    // Skills are denied unless a later rule allows one by ID (ADR 0071 delivers them); the last
    // matching rule wins, so an agent block's rules can override this deny and must allow by ID only,
    // never with "*". Skill.available
    // drops denied skills from the prompt, and the skill tool asserts action "skill" before loading
    // one (packages/core/src/skill.ts:33-34, packages/core/src/tool/plugin/skill.ts:50-55).
    { "action": "skill", "resource": "*", "effect": "deny" },
    // No subagents (old issue 261). OpenCode 2.2.0's subagent tool is on for every agent (depth 1),
    // its children outlive a cancelled turn (packages/cli/src/acp/turn.ts:303-311) and their
    // messages reach agentd only through a private extension it does not advertise, so a wall-clock
    // cancel (old issue 243) or wrap-up notice (old issue 183) would leave work running that no trace shows. Tool.snapshot
    // drops a tool whose last matching rule has resource "*" and effect deny, so the model is not
    // offered it (packages/core/src/tool.ts:255, :326-329); the tool also asserts action "subagent"
    // before it starts a child (packages/core/src/tool/plugin/subagent.ts:140). Keep this rule last
    // for the action: a later "subagent" allow would bring the tool back. Allowing "explore" again
    // waits for agentd to record child updates and cancel to cascade.
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "explore": {
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "/sandbox/.local/share/opencode/shell/*/*", "effect": "allow" },
        { "action": "external_directory", "resource": "/sandbox/.local/share/opencode/tool-output/*", "effect": "allow" },
        { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
        { "action": "external_directory", "resource": "/etc/koinon/opencode/*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  // Built-in plugins Koinon turns off: skills from ~/.claude and ~/.agents, the built-in skills
  // "opencode" and "report" (opencode.skill registers both, packages/core/src/plugin/skill.ts;
  // "report" tells the agent to file issues with the GitHub CLI), the provider plugins (the koinon
  // provider is defined below; opencode.provider.opencode cannot be removed), web search, and
  // logins for well-known integrations.
  //
  // koinon.core (ADR 0093) comes first, before koinon.retry and before anything a later document
  // (OPENCODE_CONFIG_CONTENT, user plugins) adds: the first of a duplicate plugin ID wins, so this
  // is what makes koinon.core win an ID clash (README.md, "koinon.core"). It takes no option in
  // this slice ({} below); a later module's option goes here through {env:KOINON_*}, as
  // koinon.retry's do.
  //
  // Koinon's retry plugin comes next (ADR 0056 amendment 2026-10-31, point 3): OpenCode is the one
  // layer that retries a failed model request, with Koinon's policy, not its own 10 retries. The
  // options are koinon-opencode's --model-tries, --model-retry-backoff-ms and
  // --model-max-retry-after-ms (README.md, "Model retries"). Both directories are outside every
  // config root, so nothing loads either without being listed here.
  "plugins": [
    {
      "package": "/usr/local/lib/koinon/opencode/plugins/koinon-core",
      "options": {}
    },
    {
      "package": "/usr/local/lib/koinon/opencode/plugins/koinon-retry",
      "options": {
        "tries": "{env:KOINON_MODEL_TRIES}",
        "backoffMs": "{env:KOINON_MODEL_RETRY_BACKOFF_MS}",
        "maxRetryAfterMs": "{env:KOINON_MODEL_MAX_RETRY_AFTER_MS}"
      }
    },
    "-opencode.config.compatibility",
    "-opencode.skill",
    "-opencode.provider.*",
    "-opencode.websearch.*",
    "-opencode.tool.websearch",
    "-opencode.wellknown"
  ],
  "providers": {
    "koinon": {
      "name": "Koinon agentgateway",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:KOINON_MODEL_BASE_URL}",
        "apiKey": "{env:KOINON_MODEL_KEY}"
      },
      "models": {
        "{env:KOINON_MODEL}": {}
      }
    },
    // The same gateway, for a model whose format is Anthropic Messages (ADR 0069). The base URL is
    // the same <gateway>/v1; the provider posts to <baseURL>/messages. authToken makes it send
    // "Authorization: Bearer", the header OpenShell rewrites the placeholder in and the gateway's
    // key policy reads. Never set apiKey as well: the provider refuses both
    // (packages/ai/src/providers/anthropic.ts). The entry script and koinon-agentd choose the entry
    // from the model's format (--model-format, internal/harness).
    "koinon-anthropic": {
      "name": "Koinon agentgateway (Anthropic Messages)",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "{env:KOINON_MODEL_BASE_URL}",
        "authToken": "{env:KOINON_MODEL_KEY}"
      },
      "models": {
        "{env:KOINON_MODEL}": {}
      }
    }
  },
  "mcp": {
    "servers": {
      "koinon": {
        "type": "remote",
        "url": "{env:KOINON_MCP_URL}",
        "headers": {
          "Authorization": "Bearer {env:KOINON_MODEL_KEY}"
        },
        "oauth": false,
        // Tools reach the model one by one as koinon_<tool>, not through OpenCode's code mode.
        "codemode": false
      }
    }
  }
}
