/bin/
/dist/
.env
*.local
.DS_Store
coverage.out

web/node_modules/
web/dist/
harnesses/opencode/plugins/node_modules/

# Tilt
tilt_modules/
.tilt-ko-*

# Binaries built into the repo root with go build ./cmd/<name>
/koinon-api
/koinon-agentd
/koinon-reconciler
/koinon-fakemodel
/koinon-fakegithub
/koinon-fakegitea
/koinon-fakemcp
/koinon-fakecicost
/koinon-rt1-promgen
/.e2e-out/

# Local Tilt profile and the files it names (hack/dev/local.example.yaml)
/hack/dev/local.yaml
/hack/dev/*.local.yaml

# Compiled test binaries (go test -c, ginkgo build)
*.test

# Per-spec JUnit reports of hack/go-test.sh (old issue 221) and make test-chart-smoke
# (reports/chartsmoke/; #349).
/reports/
/junit.xml
# Ginkgo's --junit-report/--json-report write these into each suite's package dir (hack/go-test.sh
# moves them to reports/; a bare `go tool ginkgo` or `go test -args -ginkgo.junit-report` leaves them)
**/junit.xml
**/report.json
__pycache__/

# hack/go-test-test.sh makes a failing-test fixture inside the module while it runs.
/internal/zzfailfixture.*/

# Per-user Claude Code files (#847). The shared project config (.claude/settings.json and what it
# registers) stays tracked; these hold one person's local settings, memory and worktrees.
CLAUDE.local.md
.claude/settings.local.json
.claude/settings.local.json.*
.claude/agent-memory-local/
.claude/worktrees/
