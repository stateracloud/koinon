# Compiled test binaries (go test -c, ginkgo build)
*.test

# Per-spec JUnit reports of hack/go-test.sh (old issue 221)
/reports/
/junit.xml
# Ginkgo's --junit-report/--json-report write these into each suite's package dir (hack/go-test.sh
# moves them to reports/; a bare `go tool ginkgo` or `go test -args -ginkgo.junit-report` leaves them)
**/junit.xml
**/report.json
