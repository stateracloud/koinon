# SPDX-License-Identifier: Apache-2.0
# shellcheck shell=bash disable=SC2034
#
# Template for the maintainer lab config (hack/lab/config.sh reads it). Copy it to
# ${XDG_CONFIG_HOME:-$HOME/.config}/koinon/lab.env (outside the repository) and fill in your own
# Argo Workflows installation. Every value below is a placeholder.

# Argo Server URL, and the namespace and WorkflowTemplate that run `make <target>` (defaults:
# koinon-e2e, koinon-make).
export KOINON_E2E_ARGO_SERVER=https://argo.example.invalid
# export KOINON_E2E_ARGO_NAMESPACE=koinon-e2e
# export KOINON_E2E_ARGO_TEMPLATE=koinon-make

# S3 buckets: where the git bundle of HEAD goes, and where the run archives its results.
export KOINON_E2E_BUNDLE_URL=https://s3.example.invalid/e2e-bundles
export KOINON_E2E_RESULTS_URL=https://s3.example.invalid/e2e-artifacts
# SigV4 region of those buckets (default us-east-1).
# export KOINON_E2E_S3_REGION=us-east-1

# A shell file that defines e2e_creds_open, e2e_creds_argo_token, e2e_creds_s3 and e2e_creds_close
# (optionally e2e_creds_results); see hack/lab/creds.example.sh.
export KOINON_E2E_ARGO_CREDS=$HOME/.config/koinon/lab/creds.sh

# --gate <set> (hack/e2e-remote.sh --argo) submits the lab's WorkflowTemplate koinon-gate and needs no
# manifest. Defaults: KOINON_E2E_GATE_TEMPLATE=koinon-gate, KOINON_E2E_GATE_PENDING=120 (seconds a run
# may stay Pending before it is given up with exit 75).
# export KOINON_E2E_GATE_TEMPLATE=koinon-gate

# Only for --lane light (superseded by --gate): an Argo Workflow manifest (JSON) for targets without a kind cluster. See the
# header of hack/e2e-argo.sh for what it must contain.
# export KOINON_E2E_LIGHT_MANIFEST=$HOME/.config/koinon/lab/light.workflow.json
