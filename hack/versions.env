# SPDX-License-Identifier: Apache-2.0
#
# The one place the versions of the build, lint and e2e tools live (old issue 544). Go itself and the
# `go tool` pins stay in go.mod; the e2e add-ons (test/e2e/kind/up.sh), Node/pnpm/Playwright (web/)
# and one-off pins elsewhere are not in this file.
#
# Format: NAME=value, one per line, no quotes, no spaces. Read three ways:
#   - shell scripts: `. hack/versions.env` (hack/chart-check.sh does)
#   - workflows: a step runs `hack/versions-env.sh >> "$GITHUB_ENV"` (it prints only the
#     <TOOL>_VERSION and <TOOL>_SHA256_AMD64/ARM64 lines, so the file cannot set BASH_ENV or PATH),
#     and later steps read ${KIND_VERSION}, ${{ env.HELM_VERSION }}
#   - literal copies that cannot read it (hack/e2e-toolchain/Dockerfile ARGs, `version:` inputs of
#     setup-helm and golangci-lint-action, the CONTRIBUTING.md table) are compared by
#     hack/versions-check.sh in preflight and CI; a mismatch fails, nothing is rewritten.
# A <TOOL>_SHA256_<ARCH> is the checksum of the release asset hack/versions-check.sh and the
# installers name (AMD64 = linux amd64/x86_64, ARM64 = linux arm64). Release assets are dated by
# hack/dep-age-check.sh (ADR 0079: at least 3 days old).
#
# To bump a tool: edit it here with its checksums, run hack/versions-check.sh, fix what it names.

KIND_VERSION=v0.33.0
KIND_SHA256_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_ARM64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2

KO_VERSION=0.19.1
KO_SHA256_AMD64=635ac6ea3fd376c935fee597fbb29ab2c2449f49ef1655085fe3aa9c25fed7a5
KO_SHA256_ARM64=4099b2d1170d3b8a70e049237462efc2dd14d5fa30e9d2e5e108fb4f778cdd3f

HELM_VERSION=v4.3.1
HELM_SHA256_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
HELM_SHA256_ARM64=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88

KUBECTL_VERSION=v1.37.0
KUBECTL_SHA256_AMD64=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f
KUBECTL_SHA256_ARM64=922df28df248cc00a9e025f947704f1d1482de64ece54cfe57e61f19eaf1eef3

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256_AMD64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256_AMD64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

# zizmor, the workflow security lint (lint-shell, hack/preflight.sh; config .github/zizmor.yml). The
# checksum is zizmor-x86_64-unknown-linux-gnu.tar.gz from the release (v1.32.0 is from 2026-11-02).
ZIZMOR_VERSION=1.32.0
ZIZMOR_SHA256_AMD64=bb110cc765eca9cd7efb2e284a956be5974c60027b0970f16397d86208a9957b

# Fetched by goreleaser-action and cosign-installer, no checksum here.
GORELEASER_VERSION=v2.18.3
COSIGN_VERSION=v3.1.4

# docker/setup-buildx-action installs this buildx in the release harness jobs (imagetools create --metadata-file).
BUILDX_VERSION=v0.37.2

# `go run ...@version` in hack/chart-check.sh.
KUBECONFORM_VERSION=v0.8.0

# golangci-lint-action `version:` in ci.yml; CONTRIBUTING.md lists it too.
GOLANGCI_LINT_VERSION=v2.15.0

# bufbuild/buf-action `version:` and `checksum:` inputs in ci.yml (the proto and generated code jobs);
# ADR 0027 names v1.75.0. The checksum is buf-Linux-x86_64 from the release's sha256.txt.
BUF_VERSION=1.75.0
BUF_SHA256_AMD64=fad1e38d6909bbb583a4da81d8c02a01046e2cd663bde7e337dd24277393764b

# `go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}` in hack/govulncheck.sh, which the
# `go-vuln` job of ci.yml, govulncheck.yml and the preflight gate `vuln` run (a Go module
# tag of golang/vuln, verified by the Go checksum database).
GOVULNCHECK_VERSION=v1.9.0

# `go run mvdan.cc/gofumpt@$GOFUMPT_VERSION` in hack/preflight.sh.
GOFUMPT_VERSION=v0.12.0

# `go install github.com/google/go-containerregistry/cmd/crane@${CRANE_VERSION}` in
# mirror-agentgateway-test-image.yml (#238; a Go module tag, verified by the Go checksum database).
CRANE_VERSION=v0.22.1
