{
  "$schema": "https://opencode.ai/config.json",
  "model": "gw/deepseek/deepseek-v4.1-flash",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "gw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Koinon agentgateway",
      "options": {
        "baseURL": "http://agentgateway.agentgateway.svc.cluster.local:8080/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {},
        "qwen3.5:4b": {}
      }
    }
  },
  "mcp": {
    "koinon": {
      "type": "remote",
      "url": "http://agentgateway.agentgateway.svc.cluster.local:8080/mcp",
      "headers": {
        "Authorization": "Bearer {env:OPENAI_API_KEY}"
      },
      "oauth": false
    }
  }
}
